# Ignore invisible
.*
*~
!.gitignore
!.gitattributes
!.github/
!.cargo/
!.cargo/config.toml
!.gitleaks.toml
!.codespellrc
!.markdownlint.json
!.markdownlintignore
!.markdownlint-cli2.yaml

/target/
**/*.rs.bk
.DS_Store

# NEAT-AI-core and NEAT-AI-Rebase live as sibling clones. If a script ever
# checks them out inside the workspace for Cargo path resolution, they must
# never be committed to this repo. These are checked out dynamically by CI
# workflows and should not be tracked as git submodules.
/NEAT-AI-core/
/NEAT-AI-core
/NEAT-AI-Rebase/
/NEAT-AI-Rebase

# Forests runtime outputs (do not commit experiment artefacts).
/runs/
/best.json
/experiments.jsonl
/winners/
**/forests-bins.cache
**/forests-residuals.cache
